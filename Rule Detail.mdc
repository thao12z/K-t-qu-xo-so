2.2 Box nhập liệu & Box đối soát
javascriptINPUT_OUTPUT_BOXES = {
  input_box: {
    title: "Nhập dữ liệu tin nhắn",
    component: "textarea",
    props: {
      value: "betText",
      onChange: "handleBetTextChange (useCallback)",
      rows: 12,
      placeholder: `Nhập hoặc paste dữ liệu cược từ tin nhắn khách...

Ví dụ:
L 23 50k
D 88 100k  
Lx 12 34 200k
BC 123 75k
lo 01,02,03 150k`,
      className: "font-mono text-sm border-2 border-gray-300 rounded-lg p-4 resize-none focus:border-blue-500 focus:outline-none",
      spellCheck: false
    },
    
    validation_realtime: {
      show_line_count: true,
      show_character_count: true,
      highlight_errors: false  // Chỉ highlight sau khi bấm Check
    }
  },
  
  output_box: {
    title: "Kết quả đối soát",
    state: "Sẽ hiển thị sau khi bấm 'Check Kết Quả'",
    
    before_check: {
      content: "Chưa có kết quả đối soát",
      style: "text-gray-500 italic text-center py-8"
    },
    
    after_check: {
      content: ["lottery_results", "summary_stats"], 
      layout: "stacked_vertical"
    },
    
    loading_state: {
      content: "Đang xử lý...",
      spinner: true,
      style: "text-blue-500 text-center py-8"
    },
    
    error_state: {
      content: "Có lỗi xảy ra. Vui lòng thử lại.",
      style: "text-red-500 text-center py-8",
      retry_button: true
    }
  }
}
2.3 Nút đối soát & Check kết quả
javascriptCHECK_BUTTON_LOGIC = {
  button: {
    text: "Check Kết Quả XSMB",
    style: "bg-blue-600 hover:bg-blue-700 text-white px-8 py-3 rounded-lg font-semibold text-lg",
    position: "center_between_boxes",
    
    states: {
      normal: { enabled: true, text: "Check Kết Quả XSMB" },
      loading: { enabled: false, text: "Đang xử lý...", spinner: true },
      disabled: { enabled: false, text: "Vui lòng nhập dữ liệu", style: "bg-gray-400" }
    }
  },
  
  validation_before_check: [
    {
      check: "betText.trim().length > 0",
      error: "Vui lòng nhập dữ liệu cược"
    },
    {
      check: "selectedDate <= today", 
      error: "Không thể chọn ngày tương lai"
    },
    {
      check: "mien === 'bac'",
      error: "Hiện tại chỉ hỗ trợ miền Bắc"
    },
    {
      check: "isResultAvailable(selectedDate, selectedMien)",
      error: "Kết quả chưa có. XSMB cập nhật lúc 18h15 hàng ngày"
    }
  ],
  
  processing_steps: [
    {
      step: 1,
      action: "Parse từng dòng betText",
      output: "parsed_bets[]"
    },
    {
      step: 2, 
      action: "Validate 4 loại cược (lo/de/xien/bacang)",
      output: "valid_bets[], error_bets[]"
    },
    {
      step: 3,
      action: "Fetch XSMB results từ RSS",
      output: "lottery_data"  
    },
    {
      step: 4,
      action: "Đối chiếu logic cho từng bet",
      output: "match_results[]"
    },
    {
      step: 5,
      action: "Tính tiền thắng/thua theo parameters",
      output: "money_results[]"
    },
    {
      step: 6,
      action: "Tổng hợp và hiển thị kết quả",
      output: "final_summary"
    }
  ]
}
2.4 Kết quả và tổng kết số tiền thắng thua
javascriptSUMMARY_RESULTS = {
  summary_cards: {
    layout: "grid_4_columns_responsive",
    
    cards: [
      {
        title: "Tổng số cược",
        value: "valid_bets.length",
        icon: "📊",
        color: "bg-blue-100 text-blue-800"
      },
      {
        title: "Số cược thắng", 
        value: "win_bets.length",
        icon: "✅",
        color: "bg-green-100 text-green-800"
      },
      {
        title: "Số cược thua",
        value: "lose_bets.length", 
        icon: "❌",
        color: "bg-red-100 text-red-800"
      },
      {
        title: "Số lỗi",
        value: "error_bets.length",
        icon: "⚠️", 
        color: "bg-yellow-100 text-yellow-800"
      }
    ]
  },
  
  money_summary: {
    layout: "large_cards_2_columns",
    
    cards: [
      {
        title: "Tổng tiền thắng",
        value: "formatMoney(total_win_amount)",
        calculation: "Sum of all win amounts",
        icon: "💰",
        color: "bg-green-50 border-green-200 text-green-700",
        details: "Chi tiết: X cược thắng"
      },
      {
        title: "Tổng tiền thua", 
        value: "formatMoney(total_lose_amount)",
        calculation: "Sum of all lose amounts",
        icon: "💸",
        color: "bg-red-50 border-red-200 text-red-700",
        details: "Chi tiết: Y cược thua"
      }
    ]
  },
  
  net_result: {
    layout: "full_width_prominent",
    
    calculation: "total_win_amount - total_lose_amount",
    
    display: {
      positive: {
        title: "Kết quả cuối cùng: THẮNG",
        value: "formatMoney(net_positive)",
        style: "bg-green-500 text-white text-2xl font-bold p-6 rounded-lg text-center",
        icon: "🎉"
      },
      negative: {
        title: "Kết quả cuối cùng: THUA", 
        value: "formatMoney(net_negative)",
        style: "bg-red-500 text-white text-2xl font-bold p-6 rounded-lg text-center",
        icon: "😞"
      },
      zero: {
        title: "Kết quả cuối cùng: HÒA",
        value: "0đ",
        style: "bg-gray-500 text-white text-2xl font-bold p-6 rounded-lg text-center", 
        icon: "🤝"
      }
    }
  }
}
